# Copy this to backend/.env and fill in real values. Never commit .env.

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider
LLM_PROVIDER_API_KEY=

# Stripe (test mode keys only, wired up in a later module)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# General
ENVIRONMENT=development
