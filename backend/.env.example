# Copy this to backend/.env and fill in real values. Never commit .env.

# Supabase (Postgres + Auth + Storage)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider (Openrouter)
LLM_PROVIDER_API_KEY=
QUERY_ANALYZER_MODEL=anthropic/claude-sonnet-5

# Embeddings / retrieval
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RETRIEVAL_MATCH_THRESHOLD=0.3
RETRIEVAL_MATCH_COUNT=3

# Hybrid Retrieval Agent (Module 3)
HYBRID_RETRIEVAL_TOP_K=20
HYBRID_RETRIEVAL_CANDIDATE_POOL=50
RETRIEVAL_RRF_K=60
RETRIEVAL_CITATION_BOOST=0.05

# Stripe (test mode keys only, wired up in a later module)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# General
ENVIRONMENT=development
