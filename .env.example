SUPABASE_DB_URL=

# LLM provider
LLM_PROVIDER_API_KEY=

# Stripe (test mode keys only, wired up in a later module)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# General
ENVIRONMENT=development


